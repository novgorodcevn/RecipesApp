<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_big"
    android:layout_marginVertical="@dimen/size_small"
    android:orientation="horizontal" >

    <TextView
        android:id="@+id/tvDescriptionRecipe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/StyleIngredientsItem"
            tools:text="Булочка для гамбургера" />

        <TextView
            android:id="@+id/tvQuantityRecipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/StyleIngredientsItem"
            tools:text="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" " />

        <TextView
            android:id="@+id/twUnitOfMeasureRecipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/StyleIngredientsItem"
            tools:text="шт" />


</LinearLayout>